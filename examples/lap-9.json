{
  "name": "lap9",
  "home": ".factory-lap9",
  "steps": [
    {"exec":["npm", "test"]},
    {"exec":["node", "--experimental-strip-types", "--no-warnings", "docs/lap-9/arms.ts", "--self-test"]},
    {"factory":["probe-isolation", "lap9-probe"]},
    {"factory":["draft", "settle-shares-loose-cc-p", "--request", "requests/settle-shares-loose.md"]},
    {"factory":["draft", "settle-shares-strict-cc-p", "--request", "requests/settle-shares-strict.md"]},
    {"factory":["draft", "booking-loose-cc-p", "--request", "requests/booking-loose.md"]},
    {"factory":["draft", "booking-strict-cc-p", "--request", "requests/booking-strict.md"]},
    {"factory":["draft", "memo-sync-loose-cc-p", "--request", "requests/memo-sync-loose.md"]},
    {"factory":["draft", "memo-sync-strict-cc-pr1", "--request", "requests/memo-sync-strict.md"]},
    {"exec":["node", "--experimental-strip-types", "--no-warnings", "docs/lap-9/arms.ts", "--provenance", "{state}", "settle-shares-loose-cc-p", "settle-shares-strict-cc-p", "booking-loose-cc-p", "booking-strict-cc-p", "memo-sync-loose-cc-p", "memo-sync-strict-cc-pr1"]},
    {"gate":"screen-specs", "approve":["settle-shares-loose-cc-p", "settle-shares-strict-cc-p", "booking-loose-cc-p", "booking-strict-cc-p", "memo-sync-loose-cc-p", "memo-sync-strict-cc-pr1"], "fix":{"prereg/screen.json":"docs/lap-9/screen.json"}},
    {"factory":["draft", "settle-shares-loose-cx-p", "--request", "requests/settle-shares-loose.md", "--spec-from", "settle-shares-loose-cc-p", "--model", "scenario-drafter=gpt-6-astra"]},
    {"factory":["draft", "settle-shares-strict-cx-p", "--request", "requests/settle-shares-strict.md", "--spec-from", "settle-shares-strict-cc-p", "--model", "scenario-drafter=gpt-6-astra"]},
    {"factory":["draft", "booking-loose-cx-p", "--request", "requests/booking-loose.md", "--spec-from", "booking-loose-cc-p", "--model", "scenario-drafter=gpt-6-astra"]},
    {"factory":["draft", "booking-strict-cx-p", "--request", "requests/booking-strict.md", "--spec-from", "booking-strict-cc-p", "--model", "scenario-drafter=gpt-6-astra"]},
    {"factory":["draft", "memo-sync-loose-cx-p", "--request", "requests/memo-sync-loose.md", "--spec-from", "memo-sync-loose-cc-p", "--model", "scenario-drafter=gpt-6-astra"]},
    {"factory":["draft", "memo-sync-strict-cx-p", "--request", "requests/memo-sync-strict.md", "--spec-from", "memo-sync-strict-cc-pr1", "--model", "scenario-drafter=gpt-6-astra"]},
    {"exec":["cmp", "{state}/vault/settle-shares-loose-cc-p/spec.md", "{state}/vault/settle-shares-loose-cx-p/spec.md"]},
    {"exec":["cmp", "{state}/vault/settle-shares-strict-cc-p/spec.md", "{state}/vault/settle-shares-strict-cx-p/spec.md"]},
    {"exec":["cmp", "{state}/vault/booking-loose-cc-p/spec.md", "{state}/vault/booking-loose-cx-p/spec.md"]},
    {"exec":["cmp", "{state}/vault/booking-strict-cc-p/spec.md", "{state}/vault/booking-strict-cx-p/spec.md"]},
    {"exec":["cmp", "{state}/vault/memo-sync-loose-cc-p/spec.md", "{state}/vault/memo-sync-loose-cx-p/spec.md"]},
    {"exec":["cmp", "{state}/vault/memo-sync-strict-cc-pr1/spec.md", "{state}/vault/memo-sync-strict-cx-p/spec.md"]},
    {"exec":["node", "--experimental-strip-types", "--no-warnings", "docs/lap-9/arms.ts", "--provenance", "{state}", "settle-shares-loose-cx-p", "settle-shares-strict-cx-p", "booking-loose-cx-p", "booking-strict-cx-p", "memo-sync-loose-cx-p", "memo-sync-strict-cx-p"]},
    {"gate":"screen", "approve":["settle-shares-loose-cx-p", "settle-shares-strict-cx-p", "booking-loose-cx-p", "booking-strict-cx-p", "memo-sync-loose-cx-p", "memo-sync-strict-cx-p"]},
    {"parallel":[{"factory":["replicate", "settle-shares-loose-cc-p", "--k", "4", "--score", "settle-shares-loose-cx-p", "--max-cost", "10"]},{"factory":["replicate", "settle-shares-strict-cc-p", "--k", "4", "--score", "settle-shares-strict-cx-p", "--max-cost", "10"]},{"factory":["replicate", "booking-loose-cc-p", "--k", "4", "--score", "booking-loose-cx-p", "--max-cost", "10"]},{"factory":["replicate", "booking-strict-cc-p", "--k", "4", "--score", "booking-strict-cx-p", "--max-cost", "10"]},{"factory":["replicate", "memo-sync-loose-cc-p", "--k", "4", "--score", "memo-sync-loose-cx-p", "--max-cost", "10"]},{"factory":["replicate", "memo-sync-strict-cc-pr1", "--k", "4", "--score", "memo-sync-strict-cx-p", "--max-cost", "10"]}], "max":4},
    {"exec":["node", "--experimental-strip-types", "--no-warnings", "docs/lap-9/arms.ts", "--screen", "{state}/prereg/screen.json", "{state}"]},
    {"gate":"main", "read":["docs/lap-9/screen-summary.md"]},
    {"factory":["draft", "settle-shares-strict-xx-1", "--request", "requests/settle-shares-strict.md", "--model", "spec-drafter=gpt-6-astra", "--model", "scenario-drafter=gpt-6-astra"]},
    {"factory":["draft", "settle-shares-strict-xx-2", "--request", "requests/settle-shares-strict.md", "--model", "spec-drafter=gpt-6-astra", "--model", "scenario-drafter=gpt-6-astra"]},
    {"factory":["draft", "settle-shares-strict-cc-1", "--request", "requests/settle-shares-strict.md"]},
    {"factory":["draft", "settle-shares-strict-cc-2", "--request", "requests/settle-shares-strict.md"]},
    {"exec":["node", "--experimental-strip-types", "--no-warnings", "docs/lap-9/arms.ts", "--provenance", "{state}", "settle-shares-strict-xx-1", "settle-shares-strict-xx-2", "settle-shares-strict-cc-1", "settle-shares-strict-cc-2"]},
    {"gate":"specs", "approve":["settle-shares-strict-xx-1", "settle-shares-strict-xx-2", "settle-shares-strict-cc-1", "settle-shares-strict-cc-2"]},
    {"factory":["draft", "settle-shares-strict-cx-1", "--request", "requests/settle-shares-strict.md", "--spec-from", "settle-shares-strict-cc-1", "--model", "scenario-drafter=gpt-6-astra"]},
    {"factory":["draft", "settle-shares-strict-xc-1", "--request", "requests/settle-shares-strict.md", "--spec-from", "settle-shares-strict-xx-1"]},
    {"factory":["draft", "settle-shares-strict-cx-2", "--request", "requests/settle-shares-strict.md", "--spec-from", "settle-shares-strict-cc-2", "--model", "scenario-drafter=gpt-6-astra"]},
    {"factory":["draft", "settle-shares-strict-xc-2", "--request", "requests/settle-shares-strict.md", "--spec-from", "settle-shares-strict-xx-2"]},
    {"exec":["cmp", "{state}/vault/settle-shares-strict-cc-1/spec.md", "{state}/vault/settle-shares-strict-cx-1/spec.md"]},
    {"exec":["cmp", "{state}/vault/settle-shares-strict-xx-1/spec.md", "{state}/vault/settle-shares-strict-xc-1/spec.md"]},
    {"exec":["cmp", "{state}/vault/settle-shares-strict-cc-2/spec.md", "{state}/vault/settle-shares-strict-cx-2/spec.md"]},
    {"exec":["cmp", "{state}/vault/settle-shares-strict-xx-2/spec.md", "{state}/vault/settle-shares-strict-xc-2/spec.md"]},
    {"exec":["node", "--experimental-strip-types", "--no-warnings", "docs/lap-9/arms.ts", "--provenance", "{state}", "settle-shares-strict-cx-1", "settle-shares-strict-xc-1", "settle-shares-strict-cx-2", "settle-shares-strict-xc-2"]},
    {"gate":"entrance", "approve":["settle-shares-strict-cx-1", "settle-shares-strict-xc-1", "settle-shares-strict-cx-2", "settle-shares-strict-xc-2"], "fix":{"prereg/prereg.json":"docs/lap-9/prereg.json"}, "read":["docs/lap-9/entrance-summary.md"]},
    {"parallel":[{"factory":["replicate", "settle-shares-strict-cc-1", "--k", "8", "--score", "settle-shares-strict-cx-1", "--max-cost", "20"]},{"factory":["replicate", "settle-shares-strict-xx-1", "--k", "8", "--score", "settle-shares-strict-xc-1", "--max-cost", "20"]},{"factory":["replicate", "settle-shares-strict-cc-2", "--k", "8", "--score", "settle-shares-strict-cx-2", "--max-cost", "20"]},{"factory":["replicate", "settle-shares-strict-xx-2", "--k", "8", "--score", "settle-shares-strict-xc-2", "--max-cost", "20"]}], "max":4},
    {"factory":["tally", "settle-shares-strict-cc-1"], "always":true},
    {"factory":["tally", "settle-shares-strict-xx-1"], "always":true},
    {"factory":["tally", "settle-shares-strict-cc-2"], "always":true},
    {"factory":["tally", "settle-shares-strict-xx-2"], "always":true},
    {"exec":["node", "--experimental-strip-types", "--no-warnings", "docs/lap-9/arms.ts", "{state}/prereg/prereg.json", "{state}"], "always":true}
  ]
}
