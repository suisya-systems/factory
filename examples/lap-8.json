{
  "name": "lap8",
  "home": ".factory-lap8",
  "steps": [
    { "exec": ["npm", "test"] },
    { "exec": ["node", "--experimental-strip-types", "--no-warnings", "docs/lap-8/arms.ts", "--self-test"] },
    { "factory": ["draft", "settle-xx-1", "--request", "requests/split-settle.md", "--model", "spec-drafter=gpt-6-astra", "--model", "scenario-drafter=gpt-6-astra"] },
    { "factory": ["probe-isolation", "lap8-probe"] },
    { "factory": ["draft", "settle-xx-2", "--request", "requests/split-settle.md", "--model", "spec-drafter=gpt-6-astra", "--model", "scenario-drafter=gpt-6-astra"] },
    { "factory": ["draft", "memo-xx-1", "--request", "requests/memo-api.md", "--model", "spec-drafter=gpt-6-astra", "--model", "scenario-drafter=gpt-6-astra"] },
    { "factory": ["draft", "memo-xx-2", "--request", "requests/memo-api.md", "--model", "spec-drafter=gpt-6-astra", "--model", "scenario-drafter=gpt-6-astra"] },
    { "factory": ["draft", "settle-cc-1", "--request", "requests/split-settle.md"] },
    { "factory": ["draft", "settle-cc-2", "--request", "requests/split-settle.md"] },
    { "factory": ["draft", "memo-cc-1", "--request", "requests/memo-api.md"] },
    { "factory": ["draft", "memo-cc-2", "--request", "requests/memo-api.md"] },
    { "exec": ["node", "--experimental-strip-types", "--no-warnings", "docs/lap-8/arms.ts", "--provenance", "{state}", "settle-cc-1", "settle-cc-2", "settle-xx-1", "settle-xx-2", "memo-cc-1", "memo-cc-2", "memo-xx-1", "memo-xx-2"] },
    { "gate": "specs", "approve": ["settle-cc-1", "settle-cc-2", "settle-xx-1", "settle-xx-2", "memo-cc-1", "memo-cc-2", "memo-xx-1", "memo-xx-2"] },
    { "factory": ["draft", "settle-cx-1r2", "--request", "requests/split-settle.md", "--spec-from", "settle-cc-1", "--model", "scenario-drafter=gpt-6-astra"] },
    { "factory": ["draft", "settle-xc-1", "--request", "requests/split-settle.md", "--spec-from", "settle-xx-1"] },
    { "factory": ["draft", "settle-cx-2", "--request", "requests/split-settle.md", "--spec-from", "settle-cc-2", "--model", "scenario-drafter=gpt-6-astra"] },
    { "factory": ["draft", "settle-xc-2", "--request", "requests/split-settle.md", "--spec-from", "settle-xx-2"] },
    { "factory": ["draft", "memo-cx-1", "--request", "requests/memo-api.md", "--spec-from", "memo-cc-1", "--model", "scenario-drafter=gpt-6-astra"] },
    { "factory": ["draft", "memo-xc-1", "--request", "requests/memo-api.md", "--spec-from", "memo-xx-1"] },
    { "factory": ["draft", "memo-cx-2", "--request", "requests/memo-api.md", "--spec-from", "memo-cc-2", "--model", "scenario-drafter=gpt-6-astra"] },
    { "factory": ["draft", "memo-xc-2", "--request", "requests/memo-api.md", "--spec-from", "memo-xx-2"] },
    { "exec": ["cmp", "{state}/vault/settle-cc-1/spec.md", "{state}/vault/settle-cx-1r2/spec.md"] },
    { "exec": ["cmp", "{state}/vault/settle-xx-1/spec.md", "{state}/vault/settle-xc-1/spec.md"] },
    { "exec": ["cmp", "{state}/vault/settle-cc-2/spec.md", "{state}/vault/settle-cx-2/spec.md"] },
    { "exec": ["cmp", "{state}/vault/settle-xx-2/spec.md", "{state}/vault/settle-xc-2/spec.md"] },
    { "exec": ["cmp", "{state}/vault/memo-cc-1/spec.md", "{state}/vault/memo-cx-1/spec.md"] },
    { "exec": ["cmp", "{state}/vault/memo-xx-1/spec.md", "{state}/vault/memo-xc-1/spec.md"] },
    { "exec": ["cmp", "{state}/vault/memo-cc-2/spec.md", "{state}/vault/memo-cx-2/spec.md"] },
    { "exec": ["cmp", "{state}/vault/memo-xx-2/spec.md", "{state}/vault/memo-xc-2/spec.md"] },
    { "exec": ["node", "--experimental-strip-types", "--no-warnings", "docs/lap-8/arms.ts", "--provenance", "{state}", "settle-cx-1r2", "settle-xc-1", "settle-cx-2", "settle-xc-2", "memo-cx-1", "memo-xc-1", "memo-cx-2", "memo-xc-2"] },
    { "gate": "entrance", "approve": ["settle-cx-1r2", "settle-xc-1", "settle-cx-2", "settle-xc-2", "memo-cx-1", "memo-xc-1", "memo-cx-2", "memo-xc-2"], "fix": { "prereg/prereg.json": "docs/lap-8/prereg.json" }, "read": ["docs/lap-8/entrance-summary.md"] },
    { "parallel": [{ "factory": ["replicate", "settle-cc-1", "--k", "8", "--score", "settle-cx-1r2", "--max-cost", "20"]}, { "factory": ["replicate", "settle-xx-1", "--k", "8", "--score", "settle-xc-1", "--max-cost", "20"]}, { "factory": ["replicate", "settle-cc-2", "--k", "8", "--score", "settle-cx-2", "--max-cost", "20"]}, { "factory": ["replicate", "settle-xx-2", "--k", "8", "--score", "settle-xc-2", "--max-cost", "20"]}, { "factory": ["replicate", "memo-cc-1", "--k", "8", "--score", "memo-cx-1", "--max-cost", "20"]}, { "factory": ["replicate", "memo-xx-1", "--k", "8", "--score", "memo-xc-1", "--max-cost", "20"]}, { "factory": ["replicate", "memo-cc-2", "--k", "8", "--score", "memo-cx-2", "--max-cost", "20"]}, { "factory": ["replicate", "memo-xx-2", "--k", "8", "--score", "memo-xc-2", "--max-cost", "20"]}], "max": 4 },
    { "factory": ["tally", "settle-cc-1"], "always": true },
    { "factory": ["tally", "settle-xx-1"], "always": true },
    { "factory": ["tally", "settle-cc-2"], "always": true },
    { "factory": ["tally", "settle-xx-2"], "always": true },
    { "factory": ["tally", "memo-cc-1"], "always": true },
    { "factory": ["tally", "memo-xx-1"], "always": true },
    { "factory": ["tally", "memo-cc-2"], "always": true },
    { "factory": ["tally", "memo-xx-2"], "always": true },
    { "exec": ["node", "--experimental-strip-types", "--no-warnings", "docs/lap-8/arms.ts", "{state}/prereg/prereg.json", "{state}"], "always": true }
  ]
}
